---
import headshot from "../assets/headshot.png"
---

<section class="section-container horizontal-center light-border container-padding vertical-padding-5 vertical-margin-1">
    <div class="horizontal-center flex-column">
        <img class="headshot horizontal-center" id="headshot" src={headshot.src} alt="headshot"/>
        <p class="text fade-in" style="text-align: center;">
            Hey, I'm <span class="text-highlight-primary">Chancellor Lam</span>! On this site, you can learn about me
            and check out the cool stuff that I'm working on.
        </p>
    </div>
</section>

<style>
    .headshot {
        border-radius: 50%;
        width: 36%;
        aspect-ratio: 1 / 1;
    }

    @media (min-width: 900px) {
        .headshot {
            width: 18%;
        }
    }
</style>
