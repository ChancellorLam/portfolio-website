---
import ExperienceItem from "./ExperienceItem.astro";

const experiences = [
    {
        jobPosition: "Software Development Intern",
        dates: "December 2024 – Present",
        workplace: "Cleveland Clinic",
        city: "Cleveland, OH",
        bulletPoints: [
            "Develop a full-stack application for the Cleveland Clinic Medical 3D Printing Lab, replacing " +
            "problematic third-party tools, reducing risk of vendor lock-in, and saving 2–5 hours of daily work for " +
            "biomedical engineers and technicians.",
            "Collaborated with a team to develop a full-stack application that allows healthcare providers to " +
            "visualize AI model outputs for medical diagnostics, improving quality of care and increasing diagnostic " +
            "efficiency.",
            "Collaborated with other interns and developers in an Agile environment to develop a tool that " +
            "streamlines radiology application configuration, reducing errors, saving developer time, and improving " +
            "application reliability."
        ]
    },
    {
        jobPosition: "Undergraduate Researcher",
        dates: "May 2024 – August 2024",
        workplace: "John Carroll University",
        city: "Cleveland, OH",
        bulletPoints: [
            "Developed a Python-based tool to automate shortest distance calculations within graphs, greatly " +
            "reducing the need for manual computations and significantly enhancing the productivity and efficiency " +
            "of research group.",
            "Mentored and introduced high school students to mathematical research in graph theory."
        ]
    },
    {
        jobPosition: "Peer Learning Facilitator",
        dates: "September 2024 – January 2025",
        workplace: "John Carroll University",
        city: "Cleveland, OH",
        bulletPoints: [
            "Provided personalized tutoring in mathematics and computer science to enhance student understanding and " +
            "academic performance."
        ]
    },
    {
        jobPosition: "Teaching Assistant/Grader",
        dates: "January 2024 – May 2025",
        workplace: "John Carroll University",
        city: "Cleveland, OH",
        bulletPoints: [
            "Assisted faculty teaching Database Systems by grading assignments and helping students understand " +
            "concepts relating to SQL and relational database design.",
            "Assisted faculty teaching Web Programming by grading assignments and helping students understand HTML, " +
            "CSS, JavaScript, and other modern web technologies."
        ]
    }
];
---
<section id="experience" class="section-container light-border horizontal-center container-padding vertical-margin-1">
    <div class="bottom-padding-3">
        <h1 class="section-header header-font-size">
            Experience
        </h1>
    </div>

    <section>
        {experiences.map(exp => (
                <section class="bottom-padding-3">
                    <ExperienceItem
                            jobPosition={exp.jobPosition}
                            dates={exp.dates}
                            workplace={exp.workplace}
                            city={exp.city}
                            bulletPoints={exp.bulletPoints}
                    />
                </section>
        ))}
    </section>
</section>
