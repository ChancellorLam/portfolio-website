---
import Logo from "./Logo.astro";
---

<div class="section-container horizontal-center">
    <nav class="flex-row-space-between-wrap">
        <Logo />

        <div class="flex-row flex-vertical-center">
            <a href="/" class="navbar-anchors">Home</a>
            <a href="#experience" class="navbar-anchors">Experience</a>
            <a href="#skills" class="navbar-anchors">Skills</a>
            <a href="#projects" class="navbar-anchors">Projects</a>
        </div>
    </nav>
</div>

<style>
    .navbar-anchors {
        color: var(--color-primary) !important;
        text-decoration: none;
        font-weight: bold;
        font-size: clamp(0.72rem, 3.6vw, 1.2rem);
        padding: 0.36rem;
        border-radius: 24px;
    }

    .navbar-anchors:hover {
        background-color: var(--color-accent);
    }
</style>
